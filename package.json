{
  "name": "unity-eoc-india",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "vite",
    "server": "python -m uvicorn backend.app.main:app --port 8000 --reload",
    "server:node": "node server/src/server.js",
    "seed": "node server/src/db/seed.js",
    "reset": "node server/src/db/seed.js --reset",
    "totp": "node server/src/tools/totp-code.js",
    "test:py": "python -m pytest -v",
    "test:auth": "node server/test/break-tests.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:client": "node server/test/client-e2e-runner.js",
    "test": "npm run test:auth && npm run test:client && npm run test:py",
    "enroll": "node server/src/tools/enroll.js"
  },
  "devDependencies": {
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide": "^0.439.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  }
}
