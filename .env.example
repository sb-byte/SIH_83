# Unity EOC — environment. Copy to .env for local overrides (.env is git-ignored).
# NOTHING here is required for local development; sane defaults apply.

# ---------------------------------------------------------------- REQUIRED IN PROD
# A long random string. The server REFUSES TO BOOT without it when
# NODE_ENV=production, because an auto-generated secret on an ephemeral filesystem
# changes on every restart and silently logs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------------------------------------------------------------- RECOMMENDED IN PROD
# Stable second-factor secrets for the Tier 1 / Tier 2 accounts, so a redeploy does
# not orphan the authenticator app you enrolled. Generate with: npm run enroll
# TOTP_SECRETS={"NDMA-AUTH-01":"BASE32SECRET","STRAT-OD-01":"BASE32SECRET"}
TOTP_SECRETS=

# Change this before any public demo. Default: Unity@2026
DEMO_PASSWORD=

# ---------------------------------------------------------------- CROSS-ORIGIN ONLY
# Only needed if the browser calls this API on a different origin. If you proxy
# /api through Vercel's rewrites (the default in vercel.json) leave this empty.
# Comma-separated; a leading *. wildcard covers Vercel preview URLs.
# ALLOWED_ORIGINS=https://unity-eoc.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- OPTIONAL
PORT=4000
TOKEN_TTL=3600
# DB_PATH=/var/data/unity-eoc.json

# ---------------------------------------------------------------- NEVER IN PROD
# Exposes GET /api/demo/totp/:credential, which hands out live second factors.
# scripts/dev.js sets this for local development only. Do not set it on a host.
# UNITY_DEMO_MODE=1
